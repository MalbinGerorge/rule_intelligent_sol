# Copy to .env and fill in. Never commit the real .env file.
# Read by both the app (app/core/config.py) and docker compose.
#
# Generate strong values with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# (url-safe output avoids characters that need escaping in URLs or compose)

ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Postgres (docker compose: postgres service) ---
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB_NAME=rule_intelligent_sol
# Database pytest creates, wipes and migrates on every run, on the same
# server as above. Must end in "_test". Optional; this is the default.
TEST_POSTGRES_DB_NAME=rule_intelligent_sol_test

# Encrypts customer_credentials.token_encrypted (pgcrypto). Changing it
# makes stored QRadar tokens undecryptable unless they're re-encrypted.
TOKEN_ENCRYPTION_KEY=

# --- Neo4j (docker compose: neo4j service) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# --- Redis (docker compose: redis service; Celery broker + result backend) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Chroma (docker compose: chroma service) ---
CHROMA_HOST=localhost
CHROMA_PORT=8001

# --- Azure OpenAI ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=

AZURE_OPENAI_ENDPOINT_4O=
AZURE_OPENAI_API_KEY_4O=
AZURE_OPENAI_DEPLOYMENT_4O=
AZURE_OPENAI_API_VERSION_4O=

# --- LangSmith tracing (optional) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rule-intelligent-sol
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
